# Copy to .env in this folder (adk web and adk deploy read it). No secrets here:
# authentication comes from Application Default Credentials, or the Cloud Run
# service account once deployed.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-lab-project-id
# Gemini 3.x is served on `global` only in the lab project.
GOOGLE_CLOUD_LOCATION=global

A4I_DATASET=a4i_health
A4I_BQ_LOCATION=US
A4I_COUNTY_FIPS=13121
A4I_COUNTY_NAME="Fulton County, GA"
A4I_MODEL=gemini-3.6-flash
